# Empty key enables unauthenticated local development.
# Set a random key with at least 32 ASCII characters before exposing the API.
THREAT_API_KEY=
THREAT_DB_PATH=data/threats.db
# Address displayed in the startup link to Swagger (adjust for a custom local port).
THREAT_PUBLIC_URL=http://127.0.0.1:8000
THREAT_RATE_LIMIT_REQUESTS=60
THREAT_RATE_LIMIT_WINDOW_SECONDS=60
THREAT_RATE_LIMIT_MAX_CLIENTS=10000
THREAT_MAX_BODY_BYTES=65536
# Docker Compose port mapping (HTTPS uses compose.https.yaml).
THREAT_HTTP_PORT=8000
THREAT_HTTPS_PORT=8443
