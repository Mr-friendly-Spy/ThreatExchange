{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Threat API: debug",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "module": "uvicorn",
      "args": ["app.main:create_app", "--factory", "--host", "127.0.0.1", "--port", "8000", "--no-proxy-headers"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
